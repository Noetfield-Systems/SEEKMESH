{
  "openapi":"3.1.0",
  "info":{"title":"SEEKMESH Discovery API","version":"0.1.0","description":"Human-curated source directory and contributor intake. Listings are not guaranteed fresh or independently verified."},
  "servers":[{"url":"/"}],
  "paths":{
    "/api/health":{"get":{"summary":"Health probe","responses":{"200":{"description":"Healthy"}}}},
    "/api/stats":{"get":{"summary":"Actual counters, not mocked traffic","responses":{"200":{"description":"Current index and registrations"}}}},
    "/api/resources":{"get":{"summary":"Search resources by name, tags, descriptions or category","parameters":[{"in":"query","name":"q","schema":{"type":"string","maxLength":140}},{"in":"query","name":"category","schema":{"type":"string"}}],"responses":{"200":{"description":"Current resources"}}}},
    "/api/discover":{"get":{"summary":"Source-grounded optional inference. LLM mode only when provider configured.","parameters":[{"in":"query","name":"q","schema":{"type":"string"}}],"responses":{"200":{"description":"Sources and optional AI answer"}}}},
    "/api/categories":{"get":{"summary":"Enumerate available categories","responses":{"200":{"description":"Available category names"}}}},
    "/api/quests":{"get":{"summary":"Read live and planned community missions","responses":{"200":{"description":"Mission catalogue"}}}},
    "/api/leaderboard":{"get":{"summary":"Actual approved-contribution reputation leaderboard","responses":{"200":{"description":"Approved contributor points"}}}},
    "/api/join":{"post":{"summary":"Record opt-in founding signup","requestBody":{"required":true,"content":{"application/json":{"schema":{"type":"object","required":["email","persona","consent"],"properties":{"email":{"type":"string","format":"email"},"persona":{"type":"string","enum":["Explorer","Builder","Curator","Agent Developer","Community","Partner"]},"consent":{"const":true},"ref":{"type":"string"}}}}}},"responses":{"201":{"description":"Signup accepted"},"200":{"description":"Existing signup"},"422":{"description":"Invalid request"}}}},
    "/api/submit":{"post":{"summary":"Submit resource to moderation queue","requestBody":{"required":true,"content":{"application/json":{"schema":{"type":"object","required":["name","url","description","category","email","handle"],"properties":{"name":{"type":"string"},"url":{"type":"string","format":"uri"},"description":{"type":"string"},"category":{"type":"string"},"email":{"type":"string","format":"email"},"handle":{"type":"string"},"tags":{"type":"string"}}}}}},"responses":{"201":{"description":"Pending review"},"422":{"description":"Invalid request"}}}}
  }
}
