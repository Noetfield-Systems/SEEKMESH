PORT=3000
PUBLIC_URL=http://localhost:3000
DATA_DIR=./data
# REQUIRED for admin review endpoints in production
ADMIN_KEY=replace-with-64-character-random-secret
# Optional server-side LLM integration; all must be configured for AI summaries
# LLM_BASE_URL=https://router.huggingface.co/v1
# LLM_MODEL=your-provider-model-id
# LLM_API_KEY=your-private-token

# SEEKMESH Autonomy OS, enabled on a deployed Node server by default.
AUTONOMY_ENABLED=true
AUTONOMY_TICK_MS=60000
AUTONOMY_CONCURRENCY=2
AUTONOMY_DAILY_REQUESTS=160
AUTONOMY_HOST_DELAY_SECONDS=45
AUTONOMY_VIRTUAL_SHARDS=2048
# Optional separate Cloudflare Cron and distributed edge discovery
AUTONOMY_ALLOW_REMOTE=false
AUTONOMY_REMOTE_DISCOVERY_ONLY=false
# Generate independent random secrets, never put real values in this file:
# AUTONOMY_CRON_KEY=<random-secret>
# AUTONOMY_WORKER_KEY=<different-random-secret>

# Embedded Realm OS (runs inside same service and SQLite volume)
REALM_OS_ENABLED=true
REALM_OS_TICK_MS=300000

# Independent Realm OS optional trusted-source publication cap (3 sources/day; strict evidence policy)
REALM_OS_AUTO_CURATE=true

# Independent SEEKMESH Web3-native funds / wallets: never use any other venture's accounts
# SEEKMESH_USDC_RECEIVER=<EVM address on Base owned by independent SEEKMESH>
# X402_FACILITATOR_URL=https://facilitator.meshgateway.co # must pass /supported x402 V2 Base eip155:8453 preflight
# BASE_RPC_URL=<https RPC for Base mainnet>
# BASE_SEPOLIA_RPC_URL=<https RPC for Base Sepolia; testnet ONLY>
# SEEKMESH_ESCROW_CONTRACT=<address deployed and verified on chain>
# SEEKMESH_ESCROW_VERIFIER=<dedicated mission proof verifier signer>
# SEEKMESH_ESCROW_CHAIN_ID=84532
# FARCASTER_ACCOUNT_ASSOCIATION={"header":"<JFS>","payload":"<JFS>","signature":"<JFS>"}

# Limit autonomous Atlas HTTP probes to 5 per UTC day; no scraping or security endorsements
ATLAS_AUTO_PROBE=true
